<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="noindex">
<title>Hello, Engineer | Special Hidden Page</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<!-- Google Fonts: Plus Jakarta Sans (Pop modern English), Zen Maru Gothic (Warm approachable Japanese), Cormorant Garamond (Classy serif accent) -->
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@1,600&family=Plus+Jakarta+Sans:wght@600;700;800&family=Zen+Maru+Gothic:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  :root {
    --paper: #fcf9f2;
    --paper-card: rgba(255, 255, 255, 0.75);
    --navy: #0f1b36;
    --navy-light: #1e2d4d;
    --navy-soft: #4a5568;
    --bordeaux: #6b1d2e;
    --bordeaux-light: #8d283f;
    --gold: #c29b4e;
    --gold-bright: #e5c365;
    --gold-light: #f3e5c8;
    --gold-soft: rgba(194, 155, 78, 0.25);
    --cream-highlight: #fffdf9;
    
    --font-ja: "Zen Maru Gothic", -apple-system, BlinkMacSystemFont, sans-serif;
    --font-en: "Plus Jakarta Sans", sans-serif;
    --font-serif: "Cormorant Garamond", serif;
  }

  * { box-sizing: border-box; }
  html, body { height: 100%; margin: 0; padding: 0; }
  
  body {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    padding: 32px 20px;
    color: var(--navy);
    font-family: var(--font-ja);
    background: 
      radial-gradient(circle at 10% 20%, rgba(229, 195, 101, 0.25) 0%, transparent 40%),
      radial-gradient(circle at 90% 85%, rgba(107, 29, 46, 0.08) 0%, transparent 45%),
      radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.8) 0%, var(--paper) 100%);
    overflow-x: hidden;
    position: relative;
  }

  /* Canvas background for animated floating sparkles & festive confetti */
  #particles-canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  /* Fine texture overlay */
  .grain {
    position: fixed; inset: 0; pointer-events: none; opacity: .04; mix-blend-mode: multiply; z-index: 2;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
  }

  /* Decorative Frame */
  .frame, .frame::after { position: fixed; pointer-events: none; z-index: 2; }
  .frame { 
    inset: 16px; 
    border: 1px solid var(--gold-soft); 
    border-radius: 20px;
  }
  .frame::after { 
    content: ""; inset: 6px; 
    border: 1px dashed rgba(194, 155, 78, 0.35); 
    border-radius: 14px;
  }

  main {
    position: relative;
    z-index: 3;
    width: 100%; 
    max-width: 560px;
    text-align: center;
    background: var(--paper-card);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: 44px 32px 38px;
    border-radius: 28px;
    border: 1px solid rgba(255, 255, 255, 0.9);
    box-shadow: 
      0 20px 50px -15px rgba(15, 27, 54, 0.08),
      0 8px 20px -6px rgba(194, 155, 78, 0.12),
      inset 0 0 0 1px rgba(255, 255, 255, 0.6);
  }

  /* Staggered entrance animation */
  .r { 
    opacity: 0; 
    transform: translateY(16px); 
    animation: riseUp 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards; 
    animation-delay: var(--d, 0s); 
  }
  @keyframes riseUp { 
    to { opacity: 1; transform: translateY(0); } 
  }

  /* Pop & Chic Header Badge */
  .badge-wrapper {
    display: inline-block;
    position: relative;
  }
  .eyebrow {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 6px 18px;
    font-family: var(--font-en);
    font-size: .78rem; font-weight: 700;
    letter-spacing: .22em; text-transform: uppercase;
    color: var(--navy);
    background: linear-gradient(135deg, #fff 0%, var(--gold-light) 100%);
    border: 1px solid var(--gold);
    border-radius: 50px;
    box-shadow: 0 4px 12px rgba(194, 155, 78, 0.15);
  }
  .eyebrow .sparkle-icon {
    color: var(--gold);
    font-size: 0.9em;
    animation: pulseGlow 2s infinite alternate;
  }
  @keyframes pulseGlow {
    from { transform: scale(0.9); opacity: 0.8; }
    to { transform: scale(1.15); opacity: 1; }
  }

  /* Stylish Ornamental Line with Code Brackets */
  .rule {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin: 22px auto;
    color: var(--gold);
    font-family: var(--font-en);
    font-weight: 800;
    font-size: 0.9rem;
    opacity: 0.85;
  }
  .rule::before, .rule::after {
    content: "";
    height: 1px;
    width: 60px;
    background: linear-gradient(90deg, transparent, var(--gold));
  }
  .rule::after {
    background: linear-gradient(90deg, var(--gold), transparent);
  }

  /* Main Title with playful typography mix */
  h1 {
    margin: 0;
    font-weight: 700;
    font-size: clamp(1.35rem, 5vw, 1.95rem);
    line-height: 1.7;
    letter-spacing: .02em;
    color: var(--navy);
  }
  h1 em { 
    font-style: normal; 
    color: var(--bordeaux); 
    font-weight: 700;
    <!-- background: linear-gradient(120deg, transparent 60%, rgba(229, 195, 101, 0.4) 60%); -->
    padding: 0 4px;
    border-radius: 4px;
  }
  h1 .sub {
    display: inline-block;
    margin-top: 12px;
    padding: 4px 14px;
    font-size: .62em; 
    font-weight: 500;
    letter-spacing: .06em;
    color: var(--navy-light);
    background: rgba(15, 27, 54, 0.04);
    border-radius: 30px;
  }
  h1 .sub b { 
    font-weight: 700; 
    color: var(--bordeaux); 
  }

  /* Note text box: NO heavy navy background, light warm paper style */
  .note {
    position: relative;
    margin: 28px 0 0;
    padding: 22px 18px;
    font-size: clamp(.88rem, 3.2vw, 0.98rem);
    font-weight: 500;
    line-height: 2.0;
    letter-spacing: .06em;
    color: var(--navy);
    background: rgba(255, 255, 255, 0.85);
    border: 1.5px solid var(--gold-light);
    border-radius: 18px;
    box-shadow: 0 8px 24px -10px rgba(194, 155, 78, 0.12);
  }
  .note::before {
    content: "✦";
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--paper);
    padding: 0 10px;
    color: var(--gold);
    font-size: 0.85rem;
  }

  /* Path indicator */
  .path {
    margin: 20px 0 0;
    font-family: var(--font-en);
    font-size: .72rem; 
    letter-spacing: .05em;
    color: var(--navy-soft);
    word-break: break-all;
    opacity: 0.8;
  }
  .path:empty { display: none; }

  /* HOME Button: NAVY base with subtle gold glow & interactive spring hover */
  .btn-container {
    margin-top: 32px;
  }
  .btn {
    position: relative; 
    overflow: hidden; 
    display: inline-flex; 
    align-items: center; 
    justify-content: center;
    gap: 10px;
    padding: 15px 44px;
    font-family: var(--font-en);
    font-size: .9rem; 
    font-weight: 800;
    letter-spacing: .25em; 
    text-indent: .25em;
    color: #ffffff;
    text-decoration: none;
    background: var(--navy);
    border: 2px solid var(--gold);
    border-radius: 50px;
    box-shadow: 
      0 10px 25px -5px rgba(15, 27, 54, 0.3),
      0 4px 12px rgba(194, 155, 78, 0.2);
    transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .btn::before {
    content: ""; 
    position: absolute; 
    inset: 0; 
    z-index: 1;
    background: linear-gradient(135deg, var(--navy-light) 0%, var(--bordeaux) 100%);
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .btn span {
    position: relative;
    z-index: 2;
  }
  .btn .arrow { 
    display: inline-block; 
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1); 
    text-indent: 0; 
    letter-spacing: 0;
    color: var(--gold-bright);
  }
  
  /* Button Hover Effect */
  .btn:hover { 
    transform: translateY(-3px) scale(1.03); 
    box-shadow: 
      0 16px 32px -6px rgba(15, 27, 54, 0.35),
      0 6px 18px rgba(194, 155, 78, 0.35);
    border-color: var(--gold-bright);
  }
  .btn:hover::before { opacity: 1; }
  .btn:hover .arrow { transform: translateX(6px); color: #fff; }
  .btn:active { transform: translateY(0) scale(0.98); }
  .btn:focus-visible { outline: 3px solid var(--gold); outline-offset: 4px; }

  /* Bottom Date Stamp */
  .stamp {
    position: fixed; 
    bottom: 28px; 
    left: 0; right: 0;
    display: flex; 
    justify-content: center; 
    align-items: center; 
    gap: 12px;
    font-family: var(--font-serif);
    font-size: .85rem; 
    font-weight: 600;
    letter-spacing: .25em; 
    color: var(--navy-soft);
    z-index: 3;
  }
  .stamp::before, .stamp::after { 
    content: ""; 
    width: 24px; 
    height: 1px; 
    background: var(--gold-soft); 
  }

  @media (max-width: 480px) {
    body { padding: 24px 16px; }
    main { padding: 36px 20px 30px; border-radius: 24px; }
    .frame { inset: 10px; }
    .frame::after { inset: 5px; }
    .btn { width: 100%; max-width: 280px; padding: 14px 20px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .r { animation: none; opacity: 1; transform: none; }
    .btn, .btn::before, .btn .arrow { transition: none; }
    #particles-canvas { display: none; }
  }
</style>
</head>
<body>
  <!-- Canvas for interactive floating confetti/sparkles -->
  <canvas id="particles-canvas"></canvas>
  
  <div class="grain" aria-hidden="true"></div>
  <div class="frame" aria-hidden="true"></div>

  <main>
    <!-- Header Badge -->
    <div class="r" style="--d:.1s">
      <div class="badge-wrapper">
        <span class="eyebrow"><span class="sparkle-icon">✦</span> Hidden Page <span class="sparkle-icon">✦</span></span>
      </div>
    </div>
   
    <div class="rule r" style="--d:.3s"></div>
    <div class="grain" aria-hidden="true"></div>
    <div class="frame" aria-hidden="true"></div>
    <!-- Code Bracket Divider -->
    <!-- <div class="rule r" style="--d:.25s">&lt; hello_world /&gt;</div> -->
    
    <!-- Title -->
    <h1 class="r" style="--d:.4s">
      このページに<br><wbr>たどり着いた<wbr>あなた！<br>
      さては<em>エンジニア</em>ですね...?<br>
      <span class="sub"><b>新郎新婦</b>もお仲間です ^^</span>
    </h1>
    
    <!-- Friendly Message (Transparent Warm Background) -->
    <p class="note r" style="--d:.7s">
      結婚式・結婚披露宴では<br>
      束の間でもお仕事のことは忘れて<br>
      ゆったりとお楽しみください！ 🎉
    </p>
    
    <!-- Current URL Path -->
    <p class="path r" id="path" style="--d:.85s"></p>
    
    <!-- HOME Button -->
    <div class="r btn-container" style="--d:1.0s">
      <a class="btn" href="../v1/index.html">
        <span>HOME</span>
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </main>

  <!-- Date Stamp -->
  <div class="stamp" id="stamp"></div>

<script>
(function () {
  // Interactive Particle/Sparkle Canvas Animation
  const canvas = document.getElementById('particles-canvas');
  const ctx = canvas.getContext('2d');

  let width, height;
  let particles = [];

  function resize() {
    width = canvas.width = window.innerWidth;
    height = canvas.height = window.innerHeight;
  }

  window.addEventListener('resize', resize);
  resize();

  // Color palette for festive sparkles
  const colors = [
    '#c29b4e', // Gold
    '#e5c365', // Bright Gold
    '#6b1d2e', // Bordeaux
    '#0f1b36', // Navy
    '#f3e5c8'  // Cream
  ];

  class Particle {
    constructor() {
      this.reset();
    }

    reset() {
      this.x = Math.random() * width;
      this.y = Math.random() * height;
      this.size = Math.random() * 4 + 1.5;
      this.color = colors[Math.floor(Math.random() * colors.length)];
      this.vx = (Math.random() - 0.5) * 0.4;
      this.vy = -Math.random() * 0.5 - 0.2; // Slow upward float
      this.alpha = Math.random() * 0.7 + 0.2;
      this.pulseSpeed = Math.random() * 0.02 + 0.01;
      this.shape = Math.random() > 0.6 ? 'star' : 'circle';
    }

    update() {
      this.x += this.vx;
      this.y += this.vy;
      this.alpha += Math.sin(Date.now() * this.pulseSpeed) * 0.01;

      // Wrap around screen
      if (this.y < -10) this.y = height + 10;
      if (this.x < -10) this.x = width + 10;
      if (this.x > width + 10) this.x = -10;
    }

    draw() {
      ctx.save();
      ctx.globalAlpha = Math.max(0, Math.min(1, this.alpha));
      ctx.fillStyle = this.color;

      if (this.shape === 'star') {
        // Draw small gold star
        ctx.beginPath();
        for (let i = 0; i < 4; i++) {
          ctx.lineTo(
            this.x + Math.cos((i * 90 * Math.PI) / 180) * this.size * 1.8,
            this.y + Math.sin((i * 90 * Math.PI) / 180) * this.size * 1.8
          );
          ctx.lineTo(
            this.x + Math.cos(((i * 90 + 45) * Math.PI) / 180) * (this.size * 0.6),
            this.y + Math.sin(((i * 90 + 45) * Math.PI) / 180) * (this.size * 0.6)
          );
        }
        ctx.closePath();
        ctx.fill();
      } else {
        // Draw subtle soft circle
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.restore();
    }
  }

  // Create particle pool
  const particleCount = Math.min(Math.floor(window.innerWidth / 20), 40);
  for (let i = 0; i < particleCount; i++) {
    particles.push(new Particle());
  }

  function animate() {
    ctx.clearRect(0, 0, width, height);
    particles.forEach(p => {
      p.update();
      p.draw();
    });
    requestAnimationFrame(animate);
  }

  animate();
})();
</script>
</body>
</html>
